generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
  ARCHIVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
  CHANGE_REQUEST
  PROBLEM
}

enum AgentRole {
  ADMIN
  AGENT
}

enum CommentAuthorType {
  AGENT
  CUSTOMER
  SYSTEM
}

model Agent {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String
  role                 AgentRole @default(AGENT)
  password             String?
  isActive             Boolean   @default(true)
  reminderEnabled      Boolean   @default(true)
  notifyOnNewTicket    Boolean   @default(true)
  notifyOnComment      Boolean   @default(true)
  notifyOnStatusChange Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  assignedTickets   Ticket[]
  comments          Comment[]
  auditLogs         AuditLog[]
  watchedTickets    TicketWatcher[]
  pushSubscriptions PushSubscription[]
  timeEntries       TimeEntry[]
  savedReplies      SavedReply[]

  @@map("agents")
}

model Customer {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String
  password             String
  isActive             Boolean   @default(true)
  notifyOnComment      Boolean   @default(true)
  notifyOnStatusChange Boolean   @default(true)
  resetToken           String?   @unique
  resetTokenExpiry     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tickets  Ticket[]
  projects ProjectCustomer[]

  @@map("customers")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets   Ticket[]
  customers ProjectCustomer[]

  @@map("projects")
}

model ProjectCustomer {
  projectId  String
  customerId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([projectId, customerId])
  @@map("project_customers")
}


model Ticket {
  id            String         @id @default(cuid())
  number        Int            @unique @default(autoincrement())
  subject       String
  description   String
  status        TicketStatus   @default(OPEN)
  priority      TicketPriority @default(MEDIUM)
  type          TicketType     @default(INCIDENT)
  email         String
  name          String
  metadata      Json?
  externalToken String         @unique @default(cuid())
  assignedToId  String?
  assignedTo    Agent?         @relation(fields: [assignedToId], references: [id])
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  resolvedAt    DateTime?
  closedAt      DateTime?
  slaDeadline   DateTime?
  slaBreached   Boolean        @default(false)

  comments          Comment[]
  tags              TicketTag[]
  attachments       Attachment[]
  auditLogs         AuditLog[]
  sourceRelations   TicketRelation[] @relation("SourceTicket")
  targetRelations   TicketRelation[] @relation("TargetTicket")
  customFieldValues TicketCustomFieldValue[]
  watchers          TicketWatcher[]
  timeEntries       TimeEntry[]

  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([email])
  @@index([assignedToId])
  @@index([customerId])
  @@index([projectId])
  @@index([createdAt])
  @@map("tickets")
}

model Comment {
  id          String            @id @default(cuid())
  ticketId    String
  ticket      Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType  CommentAuthorType
  authorId    String?
  author      Agent?            @relation(fields: [authorId], references: [id])
  authorName  String
  authorEmail String
  body        String
  isInternal  Boolean           @default(false)
  createdAt   DateTime          @default(now())

  @@index([ticketId])
  @@map("comments")
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#6366f1")
  createdAt DateTime  @default(now())

  tickets TicketTag[]

  @@map("tags")
}

model TicketTag {
  ticketId  String
  tagId     String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([ticketId, tagId])
  @@map("ticket_tags")
}

model TicketTemplate {
  id          String         @id @default(cuid())
  name        String
  subject     String
  description String
  priority    TicketPriority @default(MEDIUM)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("ticket_templates")
}

model AuditLog {
  id         String   @id @default(cuid())
  ticketId   String?
  agentId    String?
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  agent  Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AutomationRule {
  id         String   @id @default(cuid())
  name       String
  trigger    String
  conditions Json
  actions    Json
  isActive   Boolean  @default(true)
  runCount   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("automation_rules")
}

model Attachment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename     String
  mimeType     String
  size         Int
  driveFileId  String
  driveUrl     String
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([ticketId])
  @@map("attachments")
}

model TicketRelation {
  id           String   @id @default(cuid())
  ticketId     String
  relatedId    String
  relationType String
  ticket       Ticket   @relation("SourceTicket", fields: [ticketId], references: [id], onDelete: Cascade)
  related      Ticket   @relation("TargetTicket", fields: [relatedId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([ticketId, relatedId, relationType])
  @@index([ticketId])
  @@index([relatedId])
  @@map("ticket_relations")
}

model TicketWatcher {
  id       String @id @default(cuid())
  ticketId String
  agentId  String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agent    Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ticketId, agentId])
  @@index([ticketId])
  @@map("ticket_watchers")
}

model PushSubscription {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([agentId])
  @@map("push_subscriptions")
}

model Settings {
  id                     String  @id @default("default")
  reminderEnabled        Boolean @default(true)
  reminderIntervalHours  Int     @default(24)
  escalationDays         Int     @default(3)
  emailFrom              String  @default("support@yourdomain.com")
  centralNotifyEmail     String?
  notifyAgentOnComment   Boolean @default(true)
  notifyCreatorOnComment Boolean @default(true)
  slackWebhookUrl        String?
  teamsWebhookUrl        String?
  slaLowHours            Int     @default(72)
  slaMediumHours         Int     @default(48)
  slaHighHours           Int     @default(24)
  slaUrgentHours         Int     @default(4)
  slaEnabled             Boolean @default(false)

  @@map("settings")
}

model CustomField {
  id        String   @id @default(cuid())
  name      String   @unique
  label     String
  type      String   // text | number | boolean | select
  options   Json?
  required  Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values TicketCustomFieldValue[]

  @@map("custom_fields")
}

model TicketCustomFieldValue {
  id       String      @id @default(cuid())
  ticketId String
  fieldId  String
  value    String
  ticket   Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  field    CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([ticketId, fieldId])
  @@index([ticketId])
  @@map("ticket_custom_field_values")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  type      String   @unique
  name      String
  subject   String
  htmlBody  String
  variables String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model TimeEntry {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id])
  description String?
  minutes     Int
  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@index([agentId])
  @@map("time_entries")
}

model SavedReply {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String?
  agentId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  isGlobal  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("saved_replies")
}
